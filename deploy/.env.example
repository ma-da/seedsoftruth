# Seeds of Truth — environment template.
#
# Copy this file to `deploy/.env` and fill in the values that matter for
# your deployment. Never commit `deploy/.env` to git (`.gitignore` should
# cover it — verify after you create the file).
#
# Variables are grouped by tier:
#   1. Flask / web layer
#   2. Authentication / gating
#   3. RAG retrieval
#   4. LLM adapter selection
#   5. HuggingFace endpoint (only needed if MODEL_ADAPTER=hf)
#   6. DeepInfra (only needed if MODEL_ADAPTER=deepinfra)
#   7. Spark (only needed if MODEL_ADAPTER=spark)
#   8. spaCy NER

# ===========================================================================
# 1. Flask / web layer
# ===========================================================================

# Required — Flask session signing key. Generate a fresh random value
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Per ALPHA_BLOCKERS.md #6, the in-code fallback of "dev-change-me" is a
# session-forgery footgun; do not rely on it.
FLASK_SECRET_KEY=

# Optional — Flask will reload templates on change. Leave at 0 in prod.
TEMPLATES_AUTO_RELOAD=0

# ===========================================================================
# 2. Authentication / gating
# ===========================================================================

# Comma-separated list of accepted unlock passwords. Empty = chat locked.
# Per ALPHA_BLOCKERS.md #5 + #7, treat these as sensitive: don't log them,
# and consider rate-limiting /api/unlock before going public.
SOT_PASSWORDS=

# How long (seconds) the queue worker waits between init retries when
# the LLM endpoint is cold-booting.
SOT_INIT_RETRY_COOLDOWN_S=10

# ===========================================================================
# 3. RAG retrieval
# ===========================================================================

# These two paths are OVERRIDDEN by docker-compose.yml so they point at
# /app/data inside the container. Listed here for completeness — if you
# run the app outside Docker, set them to whatever absolute paths apply.
# HYBRID_DB_PATH=./data/gamma_master_hybrid_fts_stage3.db
# ENTITY_CANON_MAP_PATH=./data/entity_query_normalization_map.flat.json

# Top-K passages retrieved per query.
TRINEDAY_TOP_K=10

# Minimum BM25 score to actually answer. Below this, the app declines
# rather than generating a low-evidence response. Tuned via
# eval/calibrate_floor.py — change with care.
MIN_GATE_SCORE_FLOOR=17.0

# Fusion weights and candidate-pool sizes for entity_fts vs fulltext_fts.
HYBRID_ENTITY_WEIGHT=4.0
HYBRID_FULLTEXT_WEIGHT=1.0
HYBRID_ENTITY_LIMIT=200
HYBRID_FULLTEXT_LIMIT=200

# ===========================================================================
# 4. LLM adapter selection
# ===========================================================================

# One of: hf | deepinfra | spark | sim
#   hf        — HuggingFace Inference Endpoint (default; requires HF_*)
#   deepinfra — DeepInfra (requires DEEPINFRA_*)
#   spark     — Internal Cloudflare-Access endpoint (requires SPARK_*)
#   sim       — Deterministic test stub (no external calls; great for dev)
MODEL_ADAPTER=hf

# ===========================================================================
# 5. HuggingFace endpoint
# ===========================================================================

# Your HF Inference Endpoints bearer token. Required if MODEL_ADAPTER=hf.
HF_API_KEY=

# HF endpoint URL. Currently hardcoded in model_adapters.py:29 — once that
# becomes env-driven (recommended in STACK_EVALUATION.md), set it here.
HF_ENDPOINT_URL=

# Per-call timeout. ALPHA_BLOCKERS.md #3 recommends 120 (was 900 in code).
HF_TIMEOUT_SECS=120

# Retry attempts before giving up. ALPHA_BLOCKERS.md #3 recommends 3.
HF_MAX_ATTEMPTS=3

# Max backoff between retries (seconds).
HF_MAX_WAIT_SECS=6

# ===========================================================================
# 6. DeepInfra
# ===========================================================================

DEEPINFRA_TOKEN=
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# ===========================================================================
# 7. Spark (internal Cloudflare-Access endpoint)
# ===========================================================================

SPARK_SITE_API_KEY=
SPARK_CF_ACCESS_CLIENT_ID=
SPARK_CF_ACCESS_CLIENT_SECRET=
SPARK_MODEL_NAME=

# ===========================================================================
# 8. spaCy NER
# ===========================================================================

# Model name used for query-side entity extraction. en_core_web_sm is
# already installed in the Docker image via requirements.txt.
SPACY_MODEL=en_core_web_sm
